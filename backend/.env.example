# AMS-FaceRec Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.

# Express server port
PORT=5000

# Supabase project URL (same as frontend VITE_SUPABASE_URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous key (public — same as frontend VITE_SUPABASE_PUBLISHABLE_KEY)
SUPABASE_ANON_KEY=your_anon_key_here

# Supabase service role key — KEEP SECRET, backend only
# Found in: Supabase Dashboard > Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE=your_service_role_key_here

# Frontend URL for CORS (update for production)
FRONTEND_URL=http://localhost:5173

# Shared secret between Python face engine and Express backend.
# Set the same value in face_engine/.env and backend/.env.
# Protects POST /api/attendance/log from being called by any other process.
FACE_ENGINE_SECRET=change-me-to-a-random-secret

# Email Configuration (SMTP)
# Used for sending approval/rejection notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM_NAME="AMS-FaceRec Admin"
