# AMS-FaceRec — Frontend & Face Engine Configuration
# Copy this file to .env and fill in the Supabase details.

# Supabase Credentials (from Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Express Backend URL
VITE_BACKEND_URL=http://localhost:5003
EXPRESS_BACKEND_URL=http://localhost:5003

# Face Engine Shared Secret (Must match backend/.env FACE_ENGINE_SECRET exactly)
FACE_ENGINE_SECRET=change-me
